  <step>
    <name>Java Script Value - Calcular Montos y Armonizado</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
// Asegúrate de que los campos MONTO, Tasa_Petros, Tasa_Dolares, Tasa_Euros existan en el flujo de entrada.

// Concatenación de ID Cliente y ID Direccion
var ID_Cliente_Direccion = "";

// Accede a los campos usando sus nuevos nombres
var idCliente = ID_Cliente; // Ya no necesitas row[] si el campo está en Input fields
var idDireccion = ID_Direccion; // Ya no necesitas row[] si el campo está en Input fields

if (idCliente != null &amp;&amp; idDireccion != null) {
    ID_Cliente_Direccion = idCliente + idDireccion;
} else if (idCliente != null) {
    ID_Cliente_Direccion = idCliente;
} else if (idDireccion != null) {
    ID_Cliente_Direccion = idDireccion;
}

// Columna condicional Tipo_Documento_Texto
var Documento = ""; // Inicializamos la variable

if (Tipo_Documento == 3) { // Asumiendo que 'Tipo_Documento' es el nombre del campo que viene del Excel
    Documento = "Factura";
} else if (Tipo_Documento == 2) {
    Tipo_Documento_Texto = "Proforma";
} else {
    Documento = "Desconocido"; // O puedes dejarlo vacío "" si no quieres un valor por defecto
}


// --- Cálculos de Petros ---
var Petros = 0;
if (MONTO != null &amp;&amp; Tasa_Petros != null &amp;&amp; Tasa_Petros != 0) {
    Petros = MONTO / Tasa_Petros;
    Petros = Math.round(Petros * 100000) / 100000; // Redondear a 5 decimales
}

// --- Cálculos de Dólares ---
var Dolares = 0;
if (MONTO != null &amp;&amp; Tasa_Dolares != null &amp;&amp; Tasa_Dolares != 0) {
    Dolares = MONTO / Tasa_Dolares;
    Dolares = Math.round(Dolares * 100) / 100; // Redondear a 2 decimales
}

// --- Cálculos de Euros ---
var Euros = 0;
if (MONTO != null &amp;&amp; Tasa_Euros != null &amp;&amp; Tasa_Euros != 0) {
    Euros = MONTO / Tasa_Euros;
    Euros = Math.round(Euros * 100) / 100; // Redondear a 2 decimales
}


// --- Cálculo de Armonizado (BASADO EN LA TASA, NO EL MONTO) ---
// --- Inicialización para cada fila ---
var Armonizado = 0; // Se inicializa para cada fila, en caso de que no haya cálculo
var Tasa_Mas_Alta = 0; // Se inicializa para cada fila
var Moneda_Tasa_Mas_Alta = ""; // Se inicializa para cada fila

// --- Cálculo de Armonizado (BASADO EN LA TASA, NO EL MONTO) ---
// Primero, asegurémonos de que al menos el MONTO sea válido para intentar cálculos.
// Y que al menos una de las tasas de lookup (Dolar o Euro) no sea nula para evitar errores.
if (MONTO != null) {
    // Si solo tenemos Tasa_Dolares (y Euros es null)
    if (Tasa_Dolares != null &amp;&amp; Tasa_Euros == null) {
        Armonizado = MONTO / Tasa_Dolares;
        Tasa_Mas_Alta = Tasa_Dolares;
        Moneda_Tasa_Mas_Alta = "USD";
    }
    // Si solo tenemos Tasa_Euros (y Dolares es null)
    else if (Tasa_Euros != null &amp;&amp; Tasa_Dolares == null) {
        Armonizado = MONTO / Tasa_Euros;
        Tasa_Mas_Alta = Tasa_Euros;
        Moneda_Tasa_Mas_Alta = "EUR";
    }
    // Si tenemos AMBAS tasas (Dolares y Euros)
    else if (Tasa_Dolares != null &amp;&amp; Tasa_Euros != null) {
        if (Tasa_Dolares > Tasa_Euros) {
            Armonizado = MONTO / Tasa_Dolares;
            Tasa_Mas_Alta = Tasa_Dolares;
            Moneda_Tasa_Mas_Alta = "USD";
        } else { // Si Tasa_Euros es mayor o igual a Tasa_Dolares
            Armonizado = MONTO / Tasa_Euros;
            Tasa_Mas_Alta = Tasa_Euros;
            Moneda_Tasa_Mas_Alta = "EUR";
        }
    }
    // Si ambas son nulas o no se cumplen las condiciones, Armonizado, Tasa_Mas_Alta y Moneda_Tasa_Mas_Alta se mantienen en sus valores iniciales (0 o "").
}

Armonizado = Math.round(Armonizado * 100) / 100; // Redondear a 2 decimales, se aplica siempre si se hizo algún cálculo

// Puedes eliminar la columna temporal MONEDA_PARA_LOOKUP si no la necesitas en la salida final
// deleteRow(getVariable("MONEDA_PARA_LOOKUP", null)); // Esto si no quieres que pase al siguiente paso
</jsScript_script>
      </jsScript>
    </jsScripts>
